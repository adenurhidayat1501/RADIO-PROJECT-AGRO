{
  "name": "radio/self-hosted-platform",
  "description": "Production Self-Hosted Internet Radio Platform for Ubuntu 24.04 (PHP + MongoDB + Icecast2 + Liquidsoap)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "mongodb/mongodb": "~1.15.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {},
    "audit": {
      "block": false,
      "block-insecure": false,
      "ignore": [
        "PKSA-61k5-cqr9-b8b4"
      ]
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": [
          "mongodb/mongodb"
        ],
        "ignore-id": [
          "PKSA-61k5-cqr9-b8b4"
        ]
      }
    }
  }
}
