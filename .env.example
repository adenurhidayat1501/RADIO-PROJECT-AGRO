APP_NAME="Radio Agro"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_SECRET=radio_secret_key_change_in_production_32chars

# Database Configuration (MongoDB ONLY)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=radio_platform

# Station Identity
STATION_NAME="Radio Agro"
STATION_DESCRIPTION="Radio Komunitas Pertanian & Musik Nusantara 24/7"
STATION_GENRE="Agro, News, Dangdut & Pop Nusantara"
STATION_LANGUAGE=id
STATION_COUNTRY=ID
TIMEZONE=Asia/Jakarta

# Icecast2 Streaming Server
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_MOUNTPATH=/live
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=hackme_admin_change_me
ICECAST_SOURCE_PASSWORD=hackme_source_change_me
ICECAST_PUBLIC_URL=http://localhost:8000/live

# Liquidsoap Auto DJ & Live Harbor Engine
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_TELNET_PORT=1234
LIQUIDSOAP_HARBOR_PORT=8005
LIQUIDSOAP_HARBOR_MOUNT=/live-dj
LIQUIDSOAP_HARBOR_USER=source
LIQUIDSOAP_HARBOR_PASSWORD=dj_live_harbor_pass

# Audio Storage Directories
AUDIO_STORAGE_PATH=/var/lib/radio/music
JINGLE_STORAGE_PATH=/var/lib/radio/jingles
AD_STORAGE_PATH=/var/lib/radio/ads
FALLBACK_AUDIO_PATH=/var/lib/radio/fallback/default.mp3

# Default Stream Profile
RADIO_BITRATE=128
RADIO_FORMAT=mp3

# Security & Session
SESSION_LIFETIME=86400
